SELECT
    j.name AS JobName,
    h.step_name,
    CASE h.run_status
        WHEN 1 THEN 'Succeeded'
        WHEN 0 THEN 'Failed'
        WHEN 2 THEN 'Retry'
        WHEN 3 THEN 'Cancelled'
        WHEN 4 THEN 'In Progress'
    END AS Status,
    h.run_date,
    h.run_time,
    h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE j.name = 'Monthly_AIDB_Backup.Subplan_1'
  AND h.step_name = 'Monthly Full backups to S3'
ORDER BY h.instance_id DESC;
USE msdb;
GO

DECLARE @JobName SYSNAME = 'Your_Job_Name';

SELECT
    j.name AS JobName,
    h.instance_id,
    h.step_id,
    h.step_name,
    s.subsystem,
    s.database_name,
    s.command,
    CASE h.run_status
        WHEN 0 THEN 'Failed'
        WHEN 1 THEN 'Succeeded'
        WHEN 2 THEN 'Retry'
        WHEN 3 THEN 'Canceled'
        WHEN 4 THEN 'In Progress'
    END AS RunStatus,
    CONVERT(date, CONVERT(varchar(8), h.run_date)) AS RunDate,
    STUFF(STUFF(RIGHT('000000' + CAST(h.run_time AS varchar(6)),6),3,0,':'),6,0,':') AS RunTime,
    h.run_duration,
    h.message
FROM msdb.dbo.sysjobs j
INNER JOIN msdb.dbo.sysjobhistory h
    ON j.job_id = h.job_id
LEFT JOIN msdb.dbo.sysjobsteps s
    ON h.job_id = s.job_id
   AND h.step_id = s.step_id
WHERE j.name = @JobName
ORDER BY h.instance_id DESC;

DECLARE @Message NVARCHAR(MAX);

SELECT TOP 1
    @Message = h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE j.name = 'Monthly_AIDB_Backup_Subplan_1'
AND h.step_id = 2
ORDER BY h.instance_id DESC;

IF @Message LIKE '%Process Exit Code 0%'
BEGIN
    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = 'YourMailProfile',
        @recipients = 'abc@company.com',
        @subject = 'Monthly Backup Uploaded Successfully',
        @body = @Message;
END


USE msdb;
GO

DECLARE @JobName SYSNAME = 'Monthly_AIDB_Backup_Subplan_1';
DECLARE @Message NVARCHAR(MAX);
DECLARE @Body NVARCHAR(MAX);

-- Get the latest AWS Upload step message
SELECT TOP (1)
    @Message = h.message
FROM msdb.dbo.sysjobhistory h
INNER JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE j.name = @JobName
  AND h.step_id = 2      -- AWS Upload Step
ORDER BY h.instance_id DESC;

-- Send mail only if AWS upload completed successfully
IF @Message LIKE '%Process Exit Code 0%'
BEGIN

    SET @Body =
'Hello Team,

The database backup upload to AWS S3 has completed successfully.

Upload Status : SUCCESS

The following database backup files were generated and uploaded:

';

    SELECT @Body = @Body +
        'Database : ' + bs.database_name + CHAR(13)+CHAR(10) +
        'Backup File : ' + bmf.physical_device_name + CHAR(13)+CHAR(10) +
        'Backup Completed : ' + CONVERT(VARCHAR(19),bs.backup_finish_date,120) +
        CHAR(13)+CHAR(10)+CHAR(13)+CHAR(10)
    FROM msdb.dbo.backupset bs
    INNER JOIN msdb.dbo.backupmediafamily bmf
        ON bs.media_set_id = bmf.media_set_id
    WHERE bs.type = 'D'
      AND bs.backup_finish_date >= DATEADD(HOUR,-2,GETDATE())
    ORDER BY bs.backup_finish_date DESC;

    SET @Body = @Body +
'================================================

AWS Upload Status : SUCCESS
Process Exit Code : 0

Regards,
SQL Server Agent';

    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = 'Your_DBMail_Profile',
        @recipients   = 'dba@company.com',
        @subject      = 'Database Backup Uploaded Successfully to AWS S3',
        @body         = @Body;
END
