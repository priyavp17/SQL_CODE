SELECT
    j.name AS JobName,
    h.step_name,
    CASE h.run_status
        WHEN 1 THEN 'Succeeded'
        WHEN 0 THEN 'Failed'
        WHEN 2 THEN 'Retry'
        WHEN 3 THEN 'Cancelled'
        WHEN 4 THEN 'In Progress'
    END AS Status,
    h.run_date,
    h.run_time,
    h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE j.name = 'Monthly_AIDB_Backup.Subplan_1'
  AND h.step_name = 'Monthly Full backups to S3'
ORDER BY h.instance_id DESC;
USE msdb;
GO

DECLARE @JobName SYSNAME = 'Your_Job_Name';

SELECT
    j.name AS JobName,
    h.instance_id,
    h.step_id,
    h.step_name,
    s.subsystem,
    s.database_name,
    s.command,
    CASE h.run_status
        WHEN 0 THEN 'Failed'
        WHEN 1 THEN 'Succeeded'
        WHEN 2 THEN 'Retry'
        WHEN 3 THEN 'Canceled'
        WHEN 4 THEN 'In Progress'
    END AS RunStatus,
    CONVERT(date, CONVERT(varchar(8), h.run_date)) AS RunDate,
    STUFF(STUFF(RIGHT('000000' + CAST(h.run_time AS varchar(6)),6),3,0,':'),6,0,':') AS RunTime,
    h.run_duration,
    h.message
FROM msdb.dbo.sysjobs j
INNER JOIN msdb.dbo.sysjobhistory h
    ON j.job_id = h.job_id
LEFT JOIN msdb.dbo.sysjobsteps s
    ON h.job_id = s.job_id
   AND h.step_id = s.step_id
WHERE j.name = @JobName
ORDER BY h.instance_id DESC;

DECLARE @Message NVARCHAR(MAX);

SELECT TOP 1
    @Message = h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j
    ON h.job_id = j.job_id
WHERE j.name = 'Monthly_AIDB_Backup_Subplan_1'
AND h.step_id = 2
ORDER BY h.instance_id DESC;

IF @Message LIKE '%Process Exit Code 0%'
BEGIN
    EXEC msdb.dbo.sp_send_dbmail
        @profile_name = 'YourMailProfile',
        @recipients = 'abc@company.com',
        @subject = 'Monthly Backup Uploaded Successfully',
        @body = @Message;
END
