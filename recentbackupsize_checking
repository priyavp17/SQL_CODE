SELECT
    bs.database_name,
    bs.backup_start_date,
    bs.backup_finish_date,
    CAST(bs.backup_size / 1024.0 / 1024.0 / 1024.0 AS DECIMAL(18,2)) AS Backup_Size_GB,
    CAST(bs.compressed_backup_size / 1024.0 / 1024.0 / 1024.0 AS DECIMAL(18,2)) AS Compressed_Backup_Size_GB,
    CAST(
        (1 - (bs.compressed_backup_size * 1.0 / bs.backup_size)) * 100
        AS DECIMAL(18,2)
    ) AS Compression_Saving_Percent,
    bmf.physical_device_name
FROM msdb.dbo.backupset bs
INNER JOIN msdb.dbo.backupmediafamily bmf
    ON bs.media_set_id = bmf.media_set_id
WHERE bs.type = 'D'   -- D = Full Backup
AND bs.backup_finish_date = (
    SELECT MAX(backup_finish_date)
    FROM msdb.dbo.backupset bs2
    WHERE bs2.database_name = bs.database_name
      AND bs2.type = 'D'
)
ORDER BY bs.database_name;


SELECT
    database_name,
    backup_finish_date,
    CAST(backup_size/1024.0/1024/1024/1024 AS DECIMAL(10,2)) AS Backup_Size_GB,
    CAST(compressed_backup_size/1024.0/1024/1024/1024 AS DECIMAL(10,2)) AS Compressed_Size_GB
FROM msdb.dbo.backupset

WHERE type = 'D'
ORDER BY backup_finish_date DESC;


SELECT TOP 1  
  b.database_name AS [DatabaseName],  
  b.backup_finish_date AS [BackupFinishDate],  
  m.physical_device_name AS [BackupFilePath]  
FROM  
  msdb.dbo.backupset b  
JOIN  
  msdb.dbo.backupmediafamily m ON b.media_set_id = m.media_set_id  
WHERE  
  b.database_name = 'YourDatabaseName' -- Replace with your database name  
  AND b.type = 'D' -- 'D' = Full database backup  
ORDER BY  
  b.backup_finish_date DESC; -- Most recent first  

