/* =========================================
   PRE-CHECK SCRIPT
   ========================================= */

PRINT '===== PRE-CHECK : SQL SERVER VERSION =====';
SELECT @@SERVERNAME AS ServerName,
       @@VERSION AS SQLVersion;

PRINT '===== PRE-CHECK : DATABASE STATUS =====';
SELECT name, state_desc, recovery_model_desc
FROM sys.databases;

PRINT '===== PRE-CHECK : AG SYNCHRONIZATION STATUS =====';
SELECT ag.name AS AGName,
       ar.replica_server_name,
       DB_NAME(drs.database_id) AS DatabaseName,
       drs.synchronization_state_desc,
       drs.synchronization_health_desc,
       drs.log_send_queue_size AS LogSendQueueKB,
       drs.redo_queue_size AS RedoQueueKB
FROM sys.dm_hadr_database_replica_states drs
JOIN sys.availability_replicas ar
    ON drs.replica_id = ar.replica_id
JOIN sys.availability_groups ag
    ON ar.group_id = ag.group_id;

PRINT '===== PRE-CHECK : DISK SPACE =====';
EXEC xp_fixeddrives;

PRINT '===== PRE-CHECK : MEMORY STATUS =====';
SELECT total_physical_memory_kb/1024 AS TotalMemoryMB,
       available_physical_memory_kb/1024 AS AvailableMemoryMB,
       system_memory_state_desc
FROM sys.dm_os_sys_memory;

PRINT '===== PRE-CHECK : PAGE LIFE EXPECTANCY =====';
SELECT cntr_value AS PLE
FROM sys.dm_os_performance_counters
WHERE counter_name = 'Page life expectancy'
  AND object_name LIKE '%Buffer Manager%';

PRINT '===== PRE-CHECK : BLOCKING SESSIONS =====';
SELECT blocking_session_id,
       session_id,
       wait_type,
       wait_time,
       last_wait_type
FROM sys.dm_exec_requests
WHERE blocking_session_id <> 0;

PRINT '===== PRE-CHECK : FAILED JOBS =====';
SELECT j.name AS JobName,
       h.run_date,
       h.run_time,
       h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j ON h.job_id = j.job_id
WHERE h.run_status = 0
  AND h.step_id = 0;



/* =========================================
   POST-CHECK SCRIPT
   ========================================= */

PRINT '===== POST-CHECK : SQL SERVER UPTIME =====';
SELECT sqlserver_start_time
FROM sys.dm_os_sys_info;

PRINT '===== POST-CHECK : DATABASE STATUS =====';
SELECT name, state_desc
FROM sys.databases;

PRINT '===== POST-CHECK : AG SYNCHRONIZATION STATUS =====';
SELECT ag.name AS AGName,
       ar.replica_server_name,
       DB_NAME(drs.database_id) AS DatabaseName,
       drs.synchronization_state_desc,
       drs.synchronization_health_desc,
       drs.log_send_queue_size AS LogSendQueueKB,
       drs.redo_queue_size AS RedoQueueKB
FROM sys.dm_hadr_database_replica_states drs
JOIN sys.availability_replicas ar
    ON drs.replica_id = ar.replica_id
JOIN sys.availability_groups ag
    ON ar.group_id = ag.group_id;

PRINT '===== POST-CHECK : NON-ONLINE DATABASES =====';
SELECT name, state_desc
FROM sys.databases
WHERE state_desc NOT IN ('ONLINE');

PRINT '===== POST-CHECK : RECENT SQL ERRORS =====';
EXEC xp_readerrorlog 0, 1, 'Error', NULL, NULL, NULL, 'DESC';

PRINT '===== POST-CHECK : FAILED JOBS =====';
SELECT TOP 20 j.name AS JobName,
       h.run_date,
       h.run_time,
       h.message
FROM msdb.dbo.sysjobhistory h
JOIN msdb.dbo.sysjobs j ON h.job_id = j.job_id
WHERE h.run_status = 0
  AND h.step_id = 0
ORDER BY h.run_date DESC, h.run_time DESC;

PRINT '===== POST-CHECK : ACTIVE CONNECTIONS =====';
SELECT DB_NAME(dbid) AS DatabaseName,
       COUNT(dbid) AS NumberOfConnections
FROM sys.sysprocesses
WHERE dbid > 0
GROUP BY dbid;
