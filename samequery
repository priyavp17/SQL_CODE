WITH CTE_Count_Records AS 
		(
			SELECT 
				FBU.FU_BULK_UPLOAD_MAIN_ID,
				ISNULL(COUNT(*), 0) AS TOTAL_INVOICES_COUNT,
				SUM (CASE WHEN RFU.INV_RECORD_STATUS IN ('PROCESSED-SUCCESS') THEN 1 ELSE 0 END) AS PROCESSED_INVOICES_COUNT,
				SUM(CASE WHEN (RFU.INV_RECORD_STATUS IN ('PROCESSED-FAILURE', 'VALIDATION-FAILURE')) OR (FBU.BULK_UPLOAD_STATUS IN ('COMPLETED', 'ERROR') AND RFU.INV_RECORD_STATUS IN ('VALIDATION-SUCCESS')) THEN 1 ELSE 0 END) AS FAILED_INVOICES_COUNT
			
			FROM 
				FU_BULK_UPLOAD_MAIN FBU  
				LEFT JOIN isip_document_storage_map DSM_UPLOAD ON FBU.DSM_FILE_ID = DSM_UPLOAD.DSM_ID_PK
				LEFT JOIN isip_document_storage_map DSM_REV_FEED ON FBU.DSM_FILE_ID_REV_FEED = DSM_REV_FEED.DSM_ID_PK
				LEFT JOIN RCT_FACTORING_UNIT_BULK_DATA RFU ON FBU.FU_BULK_UPLOAD_MAIN_ID = RFU.FU_BULK_UPLOAD_MAIN_ID 
				--LEFT JOIN RCT_FACTORING_UNIT_BATCH RFUB ON RFU.FU_NUMBER = RFUB.FU_NUMBER
			WHERE
				(@USER_ID iS NULL OR @USER_ID = '' OR USER_ID = @USER_ID)
				AND
				(@filter_entityID IS NULL OR @filter_entityID = '' OR FBU.UPLOADED_ENTITY_ID = @filter_entityID)
				AND CAST(REQUEST_RECEIVED_TIME AS DATE) BETWEEN  @filter_FromDate AND @filter_ToDate 
			GROUP BY 
				FBU.FU_BULK_UPLOAD_MAIN_ID
		) 
		INSERT INTO #TEMP_FU_COUNTS
		(
			FU_BULK_UPLOAD_MAIN_ID, 
			TOTAL_INVOICES_COUNT,
			PROCESSED_INVOICES_COUNT,
			FAILED_INVOICES_COUNT
		)		
		SELECT	FU_BULK_UPLOAD_MAIN_ID, 
				TOTAL_INVOICES_COUNT,
				PROCESSED_INVOICES_COUNT,
				FAILED_INVOICES_COUNT
		FROM	CTE_Count_Records
		ORDER BY FU_BULK_UPLOAD_MAIN_ID DESC

